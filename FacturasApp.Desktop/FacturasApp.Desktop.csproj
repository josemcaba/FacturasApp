<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>FacturasApp</AssemblyName>

		<ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>

		<!-- Versionado -->
		<Version>3.2.1</Version>

		<!-- Información de la aplicación -->
		<Company>FacturasApp</Company>
		<Product>FacturasApp</Product>
		<Description>Aplicación para procesar y gestionar facturas</Description>
	</PropertyGroup>

	<!-- Referencia al proyecto Core (lógica de negocio compartida) -->
	<ItemGroup>
		<ProjectReference Include="..\FacturasApp.Core\FacturasApp.Core.csproj" />
	</ItemGroup>

	<!-- Tessdata en la raíz del repo -->
	<ItemGroup>
		<Content Include="..\tessdata\eng.traineddata" Link="tessdata\eng.traineddata">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Publish>true</Publish>
		</Content>
		<Content Include="..\tessdata\spa.traineddata" Link="tessdata\spa.traineddata">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Publish>true</Publish>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="PdfiumViewer.Updated" Version="2.14.5" />
		<PackageReference Include="bblanchon.PDFium.Win32" Version="157.0.8086" />
		<PackageReference Include="Tesseract" Version="5.2.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="UI\DetalleFacturaForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="UI\MainForm.cs">
			<SubType>Form</SubType>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="UI\MainForm.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
	</ItemGroup>

	<!-- Versionado de publicación: al publicar, el pubxml se importa (sólo con
	     -p:PublishProfile=... o desde el diálogo Publicar de Visual Studio) y
	     trae ApplicationVersion (3.2.1.*) + ApplicationRevision. Entonces se
	     hornea la versión COMPLETA de la publicación en FileVersion y
	     InformationalVersion, para que la ventana principal muestre los cuatro
	     niveles (3.2.1.16) en lugar de «3.2.1».
	     Fuera de una publicación no se toca nada: los builds normales siguen
	     con FileVersion 3.2.1.0.
	     El enganche va ANTES de GetAssemblyVersion porque ese target sólo
	     rellena FileVersion/InformationalVersion si están vacíos y, a la vez,
	     GetAssemblyAttributes (que emite los atributos) depende de él. -->
	<Target Name="FijarVersionDePublicacion"
	        BeforeTargets="GetAssemblyVersion"
	        Condition="'$(ApplicationVersion)' != '' and '$(ApplicationRevision)' != ''">
		<PropertyGroup>
			<!-- El asterisco queda sustituido por la revisión; sin asterisco se
			     le añade, igual que hace la tarea FormatVersion de ClickOnce. -->
			<_VersionPublicacion>$([System.String]::Copy('$(ApplicationVersion)').Replace('*', '$(ApplicationRevision)'))</_VersionPublicacion>
			<_VersionPublicacion Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_VersionPublicacion)', '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'))">$(_VersionPublicacion).$(ApplicationRevision)</_VersionPublicacion>
		</PropertyGroup>
		<PropertyGroup>
			<FileVersion>$(_VersionPublicacion)</FileVersion>
			<!-- Puede seguir con «+sha» (SourceRevision): MainForm lo divide. -->
			<InformationalVersion>$(_VersionPublicacion)</InformationalVersion>
		</PropertyGroup>
	</Target>

</Project>
