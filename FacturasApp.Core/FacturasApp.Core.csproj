<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>FacturasApp.Core</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Data\Emisores\*.xml">
			<LogicalName>FacturasApp.Core.Data.Emisores.%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.1" />
	</ItemGroup>

</Project>
