<?xml version="1.0" encoding="utf-8"?>
<Emisor xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Nif>General</Nif>
  <Nombre>Parser Genérico</Nombre>
  <Identificadores />
  <ModoExtraccion>OrdenadoPosicion</ModoExtraccion>
  <ConceptoIngreso>700</ConceptoIngreso>
  <ConceptoGasto>600</ConceptoGasto>
  <CulturaFecha>es-ES</CulturaFecha>
  <Campos>
    <Campo Nombre="NumeroFactura">
      <Regex>(?:factura|fra\.?|nº|n[uú]mero)[:\s#]*([A-Z0-9][-A-Z0-9/\\]{2,20})</Regex>
      <Grupo>1</Grupo>
      <UsarRegexFechaGeneral>false</UsarRegexFechaGeneral>
      <UsarRegexNifGeneral>false</UsarRegexNifGeneral>
      <EsSuma>false</EsSuma>
      <CamposSuma />
    </Campo>
    <Campo Nombre="Fecha">
      <Grupo>1</Grupo>
      <UsarRegexFechaGeneral>true</UsarRegexFechaGeneral>
      <UsarRegexNifGeneral>false</UsarRegexNifGeneral>
      <EsSuma>false</EsSuma>
      <CamposSuma />
    </Campo>
    <Campo Nombre="EmisorNif">
      <Grupo>1</Grupo>
      <UsarRegexFechaGeneral>false</UsarRegexFechaGeneral>
      <UsarRegexNifGeneral>true</UsarRegexNifGeneral>
      <EsSuma>false</EsSuma>
      <CamposSuma />
    </Campo>
    <Campo Nombre="ReceptorNif">
      <Grupo>1</Grupo>
      <UsarRegexFechaGeneral>false</UsarRegexFechaGeneral>
      <UsarRegexNifGeneral>true</UsarRegexNifGeneral>
      <EsSuma>false</EsSuma>
      <CamposSuma />
    </Campo>
    <Campo Nombre="BaseImponible">
      <Regex>(?:base\s+imponible|subtotal|base)[:\s]*([\d.,]+)</Regex>
      <Grupo>1</Grupo>
      <UsarRegexFechaGeneral>false</UsarRegexFechaGeneral>
      <UsarRegexNifGeneral>false</UsarRegexNifGeneral>
      <EsSuma>false</EsSuma>
      <CamposSuma />
    </Campo>
    <Campo Nombre="PorcentajeIVA">
      <Regex>IVA\s*(\d{1,2})\s*%</Regex>
      <Grupo>1</Grupo>
      <UsarRegexFechaGeneral>false</UsarRegexFechaGeneral>
      <UsarRegexNifGeneral>false</UsarRegexNifGeneral>
      <EsSuma>false</EsSuma>
      <CamposSuma />
    </Campo>
    <Campo Nombre="Total">
      <Regex>(?:total\s+factura|total\s+a\s+pagar|importe\s+total|total)[:\s]*([\d.,]+)</Regex>
      <Grupo>1</Grupo>
      <UsarRegexFechaGeneral>false</UsarRegexFechaGeneral>
      <UsarRegexNifGeneral>false</UsarRegexNifGeneral>
      <EsSuma>false</EsSuma>
      <CamposSuma />
    </Campo>
  </Campos>
  <PostProcesamiento />
  <ZonasOcr />
</Emisor>