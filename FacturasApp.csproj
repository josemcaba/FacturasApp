<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>

		<ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
		
		<!-- Versionado -->
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		
		<!-- Información de la aplicación -->
		<Company>FacturasApp</Company>
		<Product>FacturasApp</Product>
		<Description>Aplicación para procesar y gestionar facturas</Description>
		
		<!-- ClickOnce Configuration for .NET Desktop SDK Projects -->
		<PublishUrl>https://github.com/josemcaba/FacturasApp/releases/</PublishUrl>
		<Install>true</Install>
		<InstallFrom>Web</InstallFrom>
		<UpdateEnabled>true</UpdateEnabled>
		<UpdateMode>Foreground</UpdateMode>
		<UpdateInterval>7</UpdateInterval>
		<UpdateIntervalUnits>Days</UpdateIntervalUnits>
		<CreateWebPageOnPublish>true</CreateWebPageOnPublish>
		<WebPage>publish.htm</WebPage>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Data\plantillas_ocr.xml" />
		<None Remove="tessdata\eng.traineddata" />
		<None Remove="tessdata\spa.traineddata" />
	</ItemGroup>

	<!-- Archivo de datos: plantillas OCR (requerido, siempre se descarga) -->
	<ItemGroup>
		<Content Include="Data\plantillas_ocr.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Publish>true</Publish>
		</Content>
		
		<!-- Archivos de Tesseract (entrenamiento OCR) -->
		<Content Include="tessdata\eng.traineddata">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Publish>true</Publish>
		</Content>
		<Content Include="tessdata\spa.traineddata">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Publish>true</Publish>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="PdfPig" Version="0.1.13" />
		<PackageReference Include="PDFtoImage" Version="5.2.0" />
		<PackageReference Include="Tesseract" Version="5.2.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="FacturasApp\UI\DefinirPlantillaForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="FacturasApp\UI\DetalleFacturaForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="FacturasApp\UI\MainForm.cs">
			<SubType>Form</SubType>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="FacturasApp\UI\MainForm.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
	</ItemGroup>

</Project>