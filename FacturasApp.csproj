<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>

		<ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
		
		<!-- Versionado -->
		<Version>3.0.0</Version>
		
		<!-- Información de la aplicación -->
		<Company>FacturasApp</Company>
		<Product>FacturasApp</Product>
		<Description>Aplicación para procesar y gestionar facturas</Description>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="tessdata\eng.traineddata" />
		<None Remove="tessdata\spa.traineddata" />
	</ItemGroup>

	<!-- Referencia al proyecto Core (lógica de negocio compartida) -->
	<ItemGroup>
		<ProjectReference Include="FacturasApp.Core\FacturasApp.Core.csproj" />
	</ItemGroup>

	<!-- Archivo de plantillas: ya no está en este proyecto, viene de Core -->
	<ItemGroup>
		<Compile Remove="Tests\**" />
		<Compile Remove="FacturasApp.Core\**" />
		<Compile Remove="FacturasApp.Web\**" />
		<EmbeddedResource Remove="Tests\**" />
		<EmbeddedResource Remove="FacturasApp.Core\**" />
		<EmbeddedResource Remove="FacturasApp.Web\**" />
		<None Remove="Tests\**" />
		<None Remove="FacturasApp.Core\**" />
		<None Remove="FacturasApp.Web\**" />
		
		<!-- Archivos de Tesseract (copiados normalmente) -->
		<Content Include="tessdata\eng.traineddata">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Publish>true</Publish>
		</Content>
		<Content Include="tessdata\spa.traineddata">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Publish>true</Publish>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="PdfiumViewer.Updated" Version="2.14.5" />
		<PackageReference Include="bblanchon.PDFium.Win32" Version="139.0.7215" />
		<PackageReference Include="Tesseract" Version="5.2.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="UI\DetalleFacturaForm.cs">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="UI\MainForm.cs">
			<SubType>Form</SubType>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="UI\MainForm.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
	</ItemGroup>

</Project>